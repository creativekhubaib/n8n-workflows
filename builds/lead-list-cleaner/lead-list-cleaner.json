    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst totalRows = items.length;\nlet cleanRows = 0, duplicatesRemoved = 0, freeEmails = 0, roleEmails = 0, missingTitles = 0;\n\nfor (const item of items) {\n  const r = item.json;\n  if (r.status === \"clean\") cleanRows++;\n  if (r._is_duplicate) duplicatesRemoved++;\n  if (r._is_free) freeEmails++;\n  if (r._is_role) roleEmails++;\n  if (r._is_missing_title) missingTitles++;\n}\n\nconst issuesFlagged = totalRows - cleanRows;\nconst percentClean = totalRows > 0 ? ((cleanRows / totalRows) * 100).toFixed(1) : \"0.0\";\n\nreturn [{\n  json: {\n    run_timestamp: new Date().toISOString().slice(0, 16).replace(\"T\", \" \") + \" UTC\",\n    total_rows: totalRows,\n    clean_rows: cleanRows,\n    issues_flagged: issuesFlagged,\n    duplicates_removed: duplicatesRemoved,\n    free_emails: freeEmails,\n    role_emails: roleEmails,\n    missing_titles: missingTitles,\n    percent_clean: `${percentClean}%`\n  }\n}];"
      },
