      "parameters": {
        "jsCode": "const FREE_DOMAINS = new Set([\n  \"gmail.com\", \"yahoo.com\", \"hotmail.com\", \"outlook.com\",\n  \"icloud.com\", \"aol.com\", \"protonmail.com\", \"live.com\", \"msn.com\"\n]);\n\nconst ROLE_PREFIXES = new Set([\n  \"info\", \"sales\", \"support\", \"admin\", \"contact\", \"hello\",\n  \"office\", \"billing\", \"team\", \"careers\", \"hr\", \"marketing\", \"enquiries\"\n]);\n\nconst TITLE_MAP = {\n  \"ceo\": \"CEO\",\n  \"chief executive officer\": \"CEO\",\n  \"founder\": \"Founder\",\n  \"co-founder\": \"Co-Founder\",\n  \"cofounder\": \"Co-Founder\",\n  \"founder & ceo\": \"Founder & CEO\",\n  \"owner\": \"Founder\",\n  \"head of growth\": \"Head of Growth\",\n  \"growth lead\": \"Head of Growth\",\n  \"vp of sales\": \"VP of Sales\",\n  \"managing director\": \"Managing Director\",\n  \"director of marketing\": \"Marketing Director\"\n};\n\nfunction cleanWhitespace(val) {\n  return val ? String(val).trim().replace(/\\s+/g, \" \") : \"\";\n}\n\nfunction toTitleCase(val) {\n  const cleaned = cleanWhitespace(val);\n  return cleaned ? cleaned.toLowerCase().replace(/\\b\\w/g, c => c.toUpperCase()) : \"\";\n}\n\nfunction cleanTitle(val) {\n  const cleaned = cleanWhitespace(val);\n  if (!cleaned) return \"\";\n  const lower = cleaned.toLowerCase();\n  return TITLE_MAP[lower] || toTitleCase(cleaned);\n}\n\nfunction normaliseDomain(website, email) {\n  let raw = cleanWhitespace(website).toLowerCase();\n  if (!raw && email && email.includes(\"@\")) {\n    raw = email.split(\"@\")[1];\n  }\n  if (!raw) return \"\";\n  return raw\n    .replace(/^(https?:\\/\\/)?(www\\.)?/, \"\")\n    .split(\"/\")[0]\n    .split(\"?\")[0]\n    .split(\":\")[0]\n    .trim();\n}\n\nconst seenDomains = new Set();\nconst outputItems = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  const firstName = toTitleCase(row.first_name);\n  const lastName = toTitleCase(row.last_name);\n  const email = cleanWhitespace(row.email).toLowerCase().replace(/\\s+/g, \"\");\n  const title = cleanTitle(row.title);\n  const company = toTitleCase(row.company);\n  const cleanDom = normaliseDomain(row.website, email);\n\n  const reasons = [];\n  let flagFree = false, flagRole = false, flagMissingTitle = false, flagDuplicate = false;\n\n  if (!email || !email.includes(\"@\") || !email.split(\"@\")[1].includes(\".\")) {\n    reasons.push(\"Missing or invalid email\");\n  } else {\n    const [prefix, emailDomain] = email.split(\"@\");\n    const basePrefix = prefix.split(\"+\")[0];\n    if (FREE_DOMAINS.has(emailDomain)) {\n      flagFree = true;\n      reasons.push(`Free email provider (${emailDomain})`);\n    }\n    if (ROLE_PREFIXES.has(basePrefix)) {\n      flagRole = true;\n      reasons.push(`Role-based email (${basePrefix}@)`);\n    }\n  }\n\n  if (!title) {\n    flagMissingTitle = true;\n    reasons.push(\"Missing job title\");\n  }\n\n  if (!cleanDom || !cleanDom.includes(\".\")) {\n    reasons.push(\"Missing or invalid company domain\");\n  } else if (!FREE_DOMAINS.has(cleanDom)) {\n    if (seenDomains.has(cleanDom)) {\n      flagDuplicate = true;\n      reasons.push(`Duplicate company domain (${cleanDom})`);\n    } else {\n      seenDomains.add(cleanDom);\n    }\n  }\n\n  outputItems.push({\n    json: {\n      first_name: firstName,\n      last_name: lastName,\n      email: email,\n      clean_domain: cleanDom,\n      title: title,\n      company: company,\n      status: reasons.length === 0 ? \"clean\" : \"issue\",\n      issue_reason: reasons.join(\"; \"),\n      _is_duplicate: flagDuplicate,\n      _is_free: flagFree,\n      _is_role: flagRole,\n      _is_missing_title: flagMissingTitle\n    }\n  });\n}\n\nreturn outputItems;"
      },
