      ],
      "webhookId": "b2f1c3d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d"
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body || $json;\nconst errors = [];\n\nconst titleCase = s => String(s || '').trim().replace(/\\s+/g, ' ').toLowerCase().replace(/\\b\\w/g, c => c.toUpperCase());\n\nconst name = titleCase(b.name);\nconst email = String(b.email || '').trim().toLowerCase();\nconst company = String(b.company || '').trim();\nconst title = String(b.title || '').trim();\nconst headcount = parseInt(b.headcount, 10);\n\nif (!name) errors.push('name is required');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('email is invalid');\nif (!company) errors.push('company is required');\nif (!Number.isFinite(headcount) || headcount < 1) errors.push('headcount must be a positive number');\n\nlet score = 0;\nconst reasons = [];\nif (headcount >= 5 && headcount <= 50) { score += 40; reasons.push('team size fits ICP (5-50)'); }\nif (/founder|ceo|owner|head of growth|growth/i.test(title)) { score += 40; reasons.push('decision-maker title'); }\nif (!/@(gmail|yahoo|outlook|hotmail)\\./.test(email)) { score += 20; reasons.push('company email domain'); }\n\nreturn {\n  json: {\n    valid: errors.length === 0,\n    errors,\n    name,\n    email,\n    company,\n    title,\n    headcount: Number.isFinite(headcount) ? headcount : null,\n    score,\n    reasons,\n    received_at: new Date().toISOString()\n  }\n};"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Clean and Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
